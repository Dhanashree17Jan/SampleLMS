@{ ViewData["Title"]="Sign in"; }
<div class="login-layout"><section class="login-story"><div class="brand"><span class="login-brand"><img class="brand-logo" src="~/images/schoolnet-logo.png" alt="Schoolnet · Learning for Life"/></span></div><div><span class="eyebrow">EMPOWERING EDUCATORS</span><h1>Better training.<br/>Brighter futures.</h1><p>One workspace for your projects, schools and training journeys. Turn every day of learning into lasting impact.</p><div class="story-grid"><span>01 <strong>Plan with purpose</strong></span><span>02 <strong>Connect your people</strong></span><span>03 <strong>Measure the difference</strong></span></div></div><small>Schoolnet India · Learning without limits</small></section><section class="login-panel"><div class="login-card"><span class="eyebrow">WELCOME BACK</span><h2>Sign in to your workspace</h2><p class="muted">Manage your training programmes with confidence.</p>
@if(ViewBag.Error is string error) {<div class="notice error" role="alert">@error</div>}
<form method="post">@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><label>Username<input name="username" required autocomplete="username" autofocus maxlength="100"/></label><label>Password<input name="password" type="password" required autocomplete="current-password" maxlength="200"/></label><button class="button full" type="submit">Sign in <span>→</span></button></form><p class="login-note">Your role determines the projects and training records you can access.</p></div></section></div>
