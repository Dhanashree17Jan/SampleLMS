@model Screen
@{ViewData["Title"]=Model.Title;var b=Model.Item;var date=Model.Attendance!.Date;var available=Model.Attendance.CanMark;var present=Model.Rows.Count(r=>r.Text("status")=="Present");}
<div class="page-heading"><div><span class="eyebrow">@b.Text("code") · @b.Text("name")</span><h1>Daily attendance</h1><p>Day @Model.Day · @date.ToString("dd MMM yyyy")</p></div><a href="/Batches/Detail/@b.Id()" class="button secondary">← Batch details</a></div>
<form class="panel filterbar" method="get"><input name="id" type="hidden" value="@b.Id()"/><label>Training day<select name="day">@for(var i=1;i<=b.Id("number_of_days");i++){<option value="@i" selected="@(i==Model.Day)">Day @i · @DateOnly.Parse(b.Text("start_date")).AddDays(i-1).ToString("dd MMM yyyy")</option>}</select></label><button class="button">View day</button><span class="muted">Daily attendance: @(Model.Rows.Count==0?"Not applicable":(present*100m/Model.Rows.Count).ToString("0.#")+"%")</span></form>
@if(!available){<div class="notice info">@Model.Attendance.Message</div>}
<form method="post" action="/Attendance/Save" class="panel">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@b.Id()"/><input name="day" type="hidden" value="@Model.Day"/><div class="panel-heading"><h2>Day @Model.Day roster</h2>@if(available){<button type="button" id="mark-present" class="button secondary">Mark all present</button>}</div><div class="table-wrap"><table><thead><tr><th>Trainee</th><th>Status</th><th>Remarks</th></tr></thead><tbody>@foreach(var r in Model.Rows){<tr><td><strong>@r.Text("name")</strong><small>@r.Text("username")</small><input name="attendance_id" type="hidden" value="@r.Id()"/><input name="revision" type="hidden" value="@r.Text("revision")"/></td><td><select name="status" aria-label="Attendance for @r.Text("name")" disabled="@(!available)">@foreach(var s in new[]{"Not marked","Present","Absent"}){<option selected="@(r.Text("status")==s)">@s</option>}</select></td><td><input name="remarks" value="@r.Text("remarks")" aria-label="Remarks for @r.Text("name")" disabled="@(!available)" maxlength="2000"/></td></tr>}@if(Model.Rows.Count==0){<tr><td colspan="3" class="empty">No trainees in this batch.</td></tr>}</tbody></table></div>@if(available){<div class="form-panel"><label>Reason for past entry or correction<input name="reason" maxlength="2000" placeholder="Required for corrections and past attendance"/></label><p class="muted">Past entry and corrections require a coordinator or administrator. Saving does not change feedback completion.</p><button class="button">Save attendance</button></div>}</form>
