@model Screen
@{ViewData["Title"]=Model.Title;}
<div class="page-heading"><div><span class="eyebrow">ACCOUNTABILITY</span><h1>Audit history</h1><p>Latest 300 changes, including roster updates, training corrections and lifecycle actions.</p></div></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>Time (UTC)</th><th>Record</th><th>Action</th><th>Actor / Reason</th><th>Changes</th></tr></thead><tbody>@foreach(var r in Model.Rows){<tr><td>@r.Text("created_at")</td><td>@r.Text("entity") #@r.Text("record_id")</td><td>@r.Text("action")</td><td>@r.Text("actor")<small>@r.Text("reason")</small></td><td><details><summary>View saved changes</summary><strong>Before</strong><pre>@r.Text("old_data")</pre><strong>After</strong><pre>@r.Text("new_data")</pre></details></td></tr>}</tbody></table></div></section>
