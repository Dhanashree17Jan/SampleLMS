@model Screen
@{ViewData["Title"]=Model.Title;var groups=Model.Rows.GroupBy(r=>(r.Id("batch_id"),r.Text("username"))).ToList();}
<div class="page-heading"><div><span class="eyebrow">MEASURE YOUR IMPACT</span><h1>Reports</h1><p>Review attendance, learning activities and feedback across your permitted batches.</p></div></div>
<form class="panel filterbar report-filters" method="get">@foreach(var field in new[]{"project","school","batch","plan"}){<label>@(char.ToUpper(field[0])+field[1..])<select name="@field"><option value="0">All @(field+"s")</option>@foreach(var r in Model.Options(field+"s")){<option value="@r.Id()" selected="@(Model.Filters[field]==r.Id().ToString())">@r.Text("name") @(field=="plan"?"v"+r.Text("version_number"):"")</option>}</select></label>}<label>From date<input name="from" type="date" value="@Model.Filters["from"]"/></label><label>To date<input name="to" type="date" value="@Model.Filters["to"]"/></label><label>Trainee<input name="trainee" value="@Model.Filters["trainee"]" placeholder="Name or username"/></label><div class="actions"><button class="button">Apply filters</button><button name="export" value="true" class="button secondary">↓ Export CSV</button><a href="/Reports">Reset</a></div></form>
<section class="panel"><div class="panel-heading"><h2>Trainee attendance summary</h2><span class="muted">@groups.Count batch assignments</span></div><div class="table-wrap"><table><thead><tr><th>Trainee / Batch</th><th>Present</th><th>Absent</th><th>Not marked</th><th>Attendance</th><th>Initial / Final feedback</th></tr></thead><tbody>@foreach(var g in groups){var row=g.First();var days=row.Id("number_of_days");var marked=g.Count(r=>r.Text("attendance")=="Present");<tr><td>@row.Text("trainee")<small>@row.Text("batch")</small></td><td>@marked</td><td>@g.Count(r=>r.Text("attendance")=="Absent")</td><td>@g.Count(r=>r.Text("attendance")=="Not marked")</td><td>@(days==0?"Not applicable":(marked*100m/days).ToString("0.#")+"%")<small>@(g.Count()<days||g.Any(r=>r.Text("attendance")=="Not marked")?"Provisional":"Final")</small></td><td>@(g.FirstOrDefault(r=>r.Id("day_number")==1)?.Text("feedback")??"Outside date filter") / @(g.FirstOrDefault(r=>r.Id("day_number")==days)?.Text("feedback")??"Outside date filter")</td></tr>}@if(groups.Count==0){<tr><td colspan="6" class="empty">No training records match your filters.</td></tr>}</tbody></table></div></section>
<section class="panel"><div class="panel-heading"><h2>Daily training records</h2><span class="muted">@Model.Rows.Count records</span></div><div class="table-wrap"><table><thead><tr><th>Batch / School</th><th>Trainee</th><th>Day / Date</th><th>Activity</th><th>Attendance</th><th>Feedback</th></tr></thead><tbody>@foreach(var r in Model.Rows.Take(300)){<tr><td><a href="/Batches/Detail/@r.Id("batch_id")">@r.Text("batch")</a><small>@r.Text("school")</small></td><td>@r.Text("trainee")<small>@r.Text("username")</small></td><td>Day @r.Text("day_number")<small>@r.Text("day_date")</small></td><td>@r.Text("activity")</td><td><span class="badge @(r.Text("attendance")=="Present"?"green":r.Text("attendance")=="Absent"?"red":"gray")">@r.Text("attendance")</span></td><td>@r.Text("feedback")</td></tr>}</tbody></table></div><div class="panel-footnote">Showing up to 300 daily rows. CSV includes all records matching your filters. Attendance percentage uses the full batch duration.</div></section>
