@model Screen
@{ViewData["Title"]=Model.Title;var p=Model.Item;}
<div class="page-heading"><div><span class="eyebrow">@p.Text("plan_code") · VERSION @p.Text("version_number")</span><h1>@p.Text("plan_name")</h1><p>@p.Text("description")</p></div><a class="button secondary" href="/Plans">← All plans</a></div>
<section class="panel detail-banner"><div><span class="badge @(p.Text("status")=="Published"?"green":"orange")">@p.Text("status")</span><strong>@p.Text("number_of_days") numbered days</strong><span class="muted">Activities have day numbers; each batch sets its own dates.</span></div>@if(User.IsInRole("Administrator")){<div class="actions">@if(p.Text("status")=="Draft"){<a class="button secondary" href="/Plans/Edit/@p.Id()">Edit draft</a><form method="post" action="/Plans/Action">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id()"/><button class="button" name="operation" value="publish">Publish plan</button></form>}else{<form method="post" action="/Plans/Action">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id()"/><button class="button secondary" name="operation" value="revise">Create revision</button>@if(p.Text("status")=="Published"){<button class="button secondary" name="operation" value="archive" data-confirm="Archive this plan? Existing batches will retain it.">Archive</button>}</form>}</div>}</section>
<section class="panel"><div class="panel-heading"><h2>Day-by-day learning journey</h2></div><div class="activity-list">@foreach(var d in Model.Days){var activity=d.Id("day_number")==1 && d.Text("title")=="Pre form"?"Pre form":d.Text("activity_type");<article class="activity"><span class="day-number">@d.Text("day_number")</span><div><span class="eyebrow">DAY @d.Text("day_number") · @activity</span><h3>@d.Text("title")</h3><p>@d.Text("topics")</p><small>@d.Text("instructions")</small></div><span class="badge @(d.Text("activity_type")=="Feedback"?"orange":"blue")">@activity</span></article>}</div></section><section class="panel"><div class="panel-heading"><h2>Batches using this version</h2><span>@Model.Rows.Count batches</span></div><div class="table-wrap"><table><thead><tr><th>Batch</th><th>Project / School</th><th>Start date</th><th>Status</th></tr></thead><tbody>@foreach(var b in Model.Rows){<tr><td><a href="/Batches/Detail/@b.Id()">@b.Text("name")</a></td><td>@b.Text("project") · @b.Text("school")</td><td>@b.Text("start_date")</td><td>@b.Text("display_status")</td></tr>}@if(Model.Rows.Count==0){<tr><td colspan="4" class="empty">No batches use this plan yet.</td></tr>}</tbody></table></div></section>
