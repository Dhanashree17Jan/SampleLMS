@model Screen
@{ViewData["Title"]=Model.Title;var p=Model.Item;}
<div class="page-heading"><div><span class="eyebrow">REUSABLE LEARNING JOURNEY</span><h1>@Model.Title</h1><p>Day 1 is the Pre form, intermediate days are Classroom training, and the final day is Feedback.</p></div><a href="/Plans" class="button secondary">← All plans</a></div>
@if(Model.Error!=""){<div class="notice error" role="alert">@Model.Error</div>}
<form class="panel form-panel" method="post" id="plan-form">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@p.Id()"/><div class="form-grid"><label>Plan code *<input name="plan_code" required value="@p.Text("plan_code")" maxlength="60"/></label><label>Plan name *<input name="plan_name" required value="@p.Text("plan_name")" maxlength="200"/></label><label>Number of days *<input id="plan-days" name="number_of_days" type="number" min="2" max="365" required value="@p.Text("number_of_days")"/></label><label>Description<textarea name="description" rows="2" maxlength="2000">@p.Text("description")</textarea></label></div><div class="section-title"><h2>Numbered daily activities</h2><span id="plan-day-count" class="muted" aria-live="polite">@p.Text("number_of_days") days</span></div><p class="muted">Activities update automatically when you change the number of days. Review every day before saving.</p>
<div id="plan-day-list">@for(var i=1;i<=p.Id("number_of_days");i++){var d=Model.Days.FirstOrDefault(d=>d.Id("day_number")==i)??new Record();var boundary=i==1||i==p.Id("number_of_days");<fieldset class="plan-day" data-day="@i"><legend>Day @i · @(i==1?"Pre form":boundary?"Feedback":"Classroom training")</legend><div class="form-grid"><label>Title *<input name="day_title" required maxlength="200" value="@(d.Text("title")==""?(i==1?"Pre form":boundary?"Feedback":"Classroom training day "+i):d.Text("title"))"/></label><label>Duration (minutes)<input name="day_duration" type="number" min="1" value="@d.Text("duration_minutes")"/></label><label class="topic-label" hidden="@boundary">Classroom topics<input name="day_topics" value="@d.Text("topics")" maxlength="2000"/></label><label class="template-label" hidden="@(!boundary)">Form template<select name="day_template"><option value="">Select template</option>@foreach(var t in Model.Options("templates")){<option value="@t.Id()" selected="@(d.Id("feedback_template_version_id")==t.Id())">@t.Text("name") · v@t.Text("version_number")</option>}</select></label><label>Instructions<input name="day_instructions" value="@d.Text("instructions")" maxlength="2000"/></label></div></fieldset>}</div><div class="form-actions"><button class="button" type="submit">Save draft</button><a href="/Plans" class="button secondary">Cancel</a></div></form>
