@model Screen
@{ViewData["Title"]=Model.Title;var b=Model.Item;}
<div class="page-heading"><div><span class="eyebrow">BUILD YOUR NEXT BATCH</span><h1>@Model.Title</h1><p>Select a published plan, set your dates, then add your trainees.</p></div><a href="/Batches" class="button secondary">← All batches</a></div>@if(Model.Error!=""){<div class="notice error" role="alert">@Model.Error</div>}
<form class="panel form-panel" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.Id()"/><div class="form-grid"><label>Batch code *<input name="code" value="@b.Text("code")" required maxlength="60"/></label><label>Batch name *<input name="name" value="@b.Text("name")" required maxlength="200"/></label><label>Project *<select name="project_id" id="project-select" required><option value="">Select project</option>@foreach(var p in Model.Options("projects").Where(p=>p.Flag())){<option value="@p.Id()" selected="@(b.Id("project_id")==p.Id())">@p.Text("name")</option>}</select></label><label>School *<select name="school_id" id="school-select" required><option value="">Select school</option>@foreach(var s in Model.Options("schools").Where(s=>s.Flag())){<option value="@s.Id()" data-projects="@s.Text("projects")" selected="@(b.Id("school_id")==s.Id())">@s.Text("name")</option>}</select></label><label class="span-2">Training plan *<select name="training_plan_id" id="batch-plan" required><option value="">Select published training plan</option>@foreach(var p in Model.Options("plans")){<option value="@p.Id()" data-days="@p.Text("number_of_days")" selected="@(b.Id("training_plan_id")==p.Id())">@p.Text("plan_name") · v@p.Text("version_number") · @p.Text("number_of_days") days</option>}</select></label><label>Start date *<input name="start_date" id="batch-start" type="date" value="@b.Text("start_date")" required/></label><label>Number of days *<input name="number_of_days" id="batch-duration" type="number" value="@b.Text("number_of_days")" readonly required/></label><label>End date *<input name="end_date" id="batch-end" type="date" value="@b.Text("end_date")" readonly required/></label><label>Assigned trainer<select name="trainer_id"><option value="">Select trainer before scheduling</option>@foreach(var t in Model.Options("trainers")){<option value="@t.Id()" selected="@(b.Id("trainer_id")==t.Id())">@t.Text("name")</option>}</select></label></div><div class="notice info">The plan remains shared. Dates and training records belong to this batch. Project, school, dates, plan and roster lock after scheduling.</div><div class="form-actions"><button class="button">Save draft batch</button><a class="button secondary" href="/Batches">Cancel</a></div></form>
