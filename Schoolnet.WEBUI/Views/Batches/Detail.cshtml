@model Screen
@{ViewData["Title"]=Model.Title;var b=Model.Item;var staff=User.IsInRole("Administrator")||User.IsInRole("Coordinator");var trainee=User.IsInRole("Trainee");string Percent(long n,long d)=>d==0?"Not applicable":(n*100m/d).ToString("0.#")+"%";}
<div class="page-heading"><div><span class="eyebrow">@b.Text("code") · @b.Text("project")</span><h1>@b.Text("name")</h1><p>@b.Text("school") · @b.Text("state")</p></div><div class="actions"><a href="/Batches" class="button secondary">← All batches</a>@if(staff&&b.Text("status")=="Draft"){<a href="/Batches/Edit/@b.Id()" class="button">Edit draft</a>}</div></div>
<section class="panel batch-facts"><div><small>Status</small><span class="badge blue">@b.Text("display_status")</span></div><div><small>Dates</small><strong>@b.Text("start_date") → @b.Text("end_date")</strong></div><div><small>Training plan</small><strong>@b.Text("plan_name") · v@b.Text("version_number")</strong><small>@b.Text("number_of_days") days</small></div><div><small>Trainer</small><strong>@(b.Text("trainer")==""?"Not assigned":b.Text("trainer"))</strong></div></section>
@if(!trainee){<div class="metrics compact"><article class="metric"><div><span>Assigned trainees</span><strong>@b.Text("trainees")</strong></div></article><article class="metric"><div><span>Unmarked attendance</span><strong>@b.Text("unmarked")</strong></div></article><article class="metric"><div><span>Initial feedback</span><strong>@Percent(b.Id("initial_feedback"),b.Id("trainees"))</strong></div></article><article class="metric"><div><span>Final feedback</span><strong>@Percent(b.Id("final_feedback"),b.Id("trainees"))</strong></div></article></div>}
<section class="panel"><div class="panel-heading"><h2>Daily activities</h2><span class="muted">Shared plan · batch dates</span></div><div class="table-wrap"><table><thead><tr><th>Day</th><th>Batch date</th><th>Activity</th><th>Topics / instructions</th>@if(!trainee){<th>Attendance</th>}</tr></thead><tbody>@foreach(var d in Model.Days){<tr><td><span class="day-pill">@d.Text("day_number")</span></td><td>@d.Text("day_date")</td><td><strong>@d.Text("title")</strong><small>@d.Text("activity_type")</small></td><td>@d.Text("topics")<small>@d.Text("instructions")</small></td>@if(!trainee){<td><a href="/Attendance?id=@b.Id()&day=@d.Text("day_number")">View / mark →</a></td>}</tr>}</tbody></table></div></section>
<section class="panel"><div class="panel-heading"><h2>@(trainee?"Your training progress":"Trainee roster")</h2><span>@Model.Roster.Count @(trainee?"assignment":"trainees")</span></div><div class="table-wrap"><table><thead><tr><th>Trainee</th><th>Present</th><th>Absent</th><th>Not marked</th><th>Attendance</th><th>Feedback</th>@if(staff&&b.Text("status")=="Draft"){<th>Action</th>}</tr></thead><tbody>@foreach(var r in Model.Roster){<tr><td><strong>@r.Text("name")</strong><small>@r.Text("username")</small></td><td>@r.Text("present")</td><td>@r.Text("absent")</td><td>@r.Text("unmarked")</td><td>@Percent(r.Id("present"),r.Id("total"))@if(r.Id("unmarked")>0){<small class="muted">Provisional</small>}</td><td>@if(staff||trainee){<a href="/Feedback?assignment=@r.Id()&day=1">Initial: @(r.Id("initial_feedback")>0?"Submitted":"Missing")</a><small><a href="/Feedback?assignment=@r.Id()&day=@b.Text("number_of_days")">Final: @(r.Id("final_feedback")>0?"Submitted":"Missing")</a></small>}else{<span>Initial: @(r.Id("initial_feedback")>0?"Submitted":"Missing")</span><small>Final: @(r.Id("final_feedback")>0?"Submitted":"Missing")</small>}</td>@if(staff&&b.Text("status")=="Draft"){<td><form method="post" action="/Batches/Remove">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.Id()"/><input type="hidden" name="assignment" value="@r.Id()"/><button class="text-button danger" data-confirm="Remove this trainee from the draft batch?">Remove</button></form></td>}</tr>}@if(Model.Roster.Count==0){<tr><td colspan="7" class="empty">No trainees assigned yet.</td></tr>}</tbody></table></div></section>
@if(staff&&b.Text("status")=="Draft"){<section class="panel form-panel"><h2>Assign eligible trainees</h2><p class="muted">Trainees must belong to this project and school. Scheduled batch overlaps are checked when assigning and scheduling.</p><form method="post" action="/Batches/Assign">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.Id()"/><div class="check-grid">@foreach(var t in Model.Eligible){<label class="checkbox"><input type="checkbox" name="trainees" value="@t.Id()"/>@t.Text("name") <small>@t.Text("username")</small></label>}</div>@if(Model.Eligible.Count>0){<button class="button">Assign selected trainees</button>}else{<p>No unassigned eligible trainees. <a href="/Masters/Edit?kind=trainee">Add a trainee</a>.</p>}</form></section>}
@if(staff&&b.Text("status") is not ("Completed" or "Cancelled")){<section class="panel form-panel"><h2>Batch lifecycle</h2><form class="lifecycle" method="post" action="/Batches/Transition">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.Id()"/><label>Reason (required for cancellation)<input name="reason" maxlength="2000" placeholder="Explain the change when required"/></label><div class="actions">@if(b.Text("status")=="Draft"){<button class="button" name="status" value="Scheduled">Schedule batch</button>}else{<button class="button" name="status" value="Completed">Complete batch</button><button class="button secondary" name="status" value="Draft">Return to draft</button>}<button class="button secondary danger" name="status" value="Cancelled" data-confirm="Cancel this batch? Training records will be preserved.">Cancel batch</button></div></form><p class="muted">Completion is available after the end date, once all attendance is marked. Missing feedback does not block completion.</p></section>}
@if(b.Text("status")=="Cancelled"){<div class="notice info">Cancellation reason: @b.Text("cancellation_reason")</div>}
