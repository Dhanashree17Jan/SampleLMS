@model Screen
@{ViewData["Title"]=Model.Title;}
<div class="page-heading"><div><span class="eyebrow">TRAINING DELIVERY</span><h1>Batches</h1><p>Bring your plans, schools and people together.</p></div>@if(User.IsInRole("Administrator")||User.IsInRole("Coordinator")){<a class="button" href="/Batches/Edit">+ Create batch</a>}</div>
<form class="panel filterbar" method="get"><label>Search<input name="search" value="@Model.Filters["search"]" placeholder="Batch name or code"/></label><label>Project<select name="project"><option value="0">All projects</option>@foreach(var p in Model.Options("projects")){<option value="@p.Id()" selected="@(Model.Filters["project"]==p.Id().ToString())">@p.Text("name")</option>}</select></label><label>School<select name="school"><option value="0">All schools</option>@foreach(var s in Model.Options("schools")){<option value="@s.Id()" selected="@(Model.Filters["school"]==s.Id().ToString())">@s.Text("name")</option>}</select></label><label>Status<select name="status"><option value="">All statuses</option>@foreach(var s in new[]{"Draft","Scheduled","In progress","Completed","Cancelled"}){<option selected="@(Model.Filters["status"]==s)">@s</option>}</select></label><button class="button">Apply filters</button></form>
<section class="panel"><div class="panel-heading"><h2>Batch directory</h2><span>@Model.Rows.Count batches</span></div><div class="table-wrap"><table><thead><tr><th>Batch</th><th>Project / School</th><th>Training plan</th><th>Dates</th><th>Trainees</th><th>Status</th></tr></thead><tbody>@foreach(var b in Model.Rows){<tr><td><a class="table-link" href="/Batches/Detail/@b.Id()">@b.Text("name")</a><small>@b.Text("code")</small></td><td>@b.Text("project")<small>@b.Text("school")</small></td><td>@b.Text("plan_name")<small>v@b.Text("version_number") · @b.Text("number_of_days") days</small></td><td>@b.Text("start_date")<small>to @b.Text("end_date")</small></td><td>@b.Text("trainees")</td><td><span class="badge @(b.Text("status")=="Completed"?"green":b.Text("display_status")=="In progress"?"blue":"orange")">@b.Text("display_status")</span></td></tr>}@if(Model.Rows.Count==0){<tr><td colspan="6" class="empty">No batches match your filters.</td></tr>}</tbody></table></div></section>
