@model Screen
@{ ViewData["Title"]=Model.Title; var total=Model.Rows.Count; var ongoing=Model.Rows.Count(b=>b.Text("display_status")=="In progress"); var complete=Model.Rows.Count(b=>b.Text("status")=="Completed"); var upcoming=Model.Rows.Count(b=>b.Text("display_status")=="Scheduled"); var projects=Model.Options("projects").Count(p=>p.Flag()&&(Model.Filters["project"]=="0"||p.Id().ToString()==Model.Filters["project"])&&(Model.Filters["school"]=="0"||Model.Options("schools").Any(s=>s.Id().ToString()==Model.Filters["school"]&&s.Array("projects").Any(x=>x!.ToString()==p.Id().ToString())))&&(Model.Filters["state"]=="0"||Model.Options("schools").Any(s=>s.Id("state_id").ToString()==Model.Filters["state"]&&s.Array("projects").Any(x=>x!.ToString()==p.Id().ToString())))); }
<div class="page-heading"><div><span class="eyebrow">YOUR TRAINING WORKSPACE</span><h1>Dashboard</h1><p>A clear view of your people, programmes and progress.</p></div><span class="date-chip">@DateTime.Now.ToString("dddd, dd MMM yyyy")</span></div>
<div class="metrics"><article class="metric"><div><span>Active trainees</span><strong>@Model.Item.Id("count").ToString("N0")</strong><small>Across your selected scope</small></div><span class="metric-icon cyan">♧</span></article><article class="metric"><div><span>Current projects</span><strong>@projects</strong><small>Active learning programmes</small></div><span class="metric-icon blue">▱</span></article><article class="metric"><div><span>Ongoing batches</span><strong>@ongoing</strong><small>Learning in progress</small></div><span class="metric-icon orange">▦</span></article><article class="metric"><div><span>Completed batches</span><strong>@complete</strong><small>Training journeys completed</small></div><span class="metric-icon green">✓</span></article></div>
<form class="panel filterbar" method="get"><label>Project<select name="project"><option value="0">All projects</option>@foreach(var p in Model.Options("projects")){<option value="@p.Id()" selected="@(Model.Filters["project"]==p.Id().ToString())">@p.Text("name")</option>}</select></label><label>State<select name="state"><option value="0">All states</option>@foreach(var s in Model.Options("locations").Where(s=>s.Text("kind")=="State")){<option value="@s.Id()" selected="@(Model.Filters["state"]==s.Id().ToString())">@s.Text("name")</option>}</select></label><label>School<select name="school"><option value="0">All schools</option>@foreach(var s in Model.Options("schools")){<option value="@s.Id()" selected="@(Model.Filters["school"]==s.Id().ToString())">@s.Text("name")</option>}</select></label><button class="button" type="submit">Apply filters</button><a class="text-button" href="/">Reset</a></form>
<div class="dashboard-grid"><section class="panel"><div class="panel-heading"><h2>Detailed numerical summaries</h2><span class="muted">Current scope</span></div><div class="table-wrap"><table><thead><tr><th>Metric</th><th>Count</th><th>Overview</th></tr></thead><tbody><tr><td>Active trainees</td><td><strong>@Model.Item.Id("count")</strong></td><td><span class="badge green">Active</span></td></tr><tr><td>Current projects</td><td>@projects</td><td>Active programmes</td></tr><tr><td>Ongoing batches</td><td>@ongoing</td><td><span class="badge blue">In progress</span></td></tr><tr><td>Upcoming batches</td><td>@upcoming</td><td><span class="badge orange">Scheduled</span></td></tr><tr><td>Completed batches</td><td>@complete</td><td><span class="badge green">Completed</span></td></tr><tr><td>Unmarked attendance</td><td>@Model.Rows.Where(r=>r.Text("status")!="Cancelled").Sum(r=>r.Id("unmarked"))</td><td>Includes upcoming days</td></tr><tr class="total"><td>Total batches</td><td>@total</td><td>All statuses</td></tr></tbody></table></div><div class="panel-footnote">Attendance and feedback are tracked separately for each batch.</div></section><section class="panel"><div class="panel-heading"><h2>Batch overview</h2><a href="/Batches">View all →</a></div><div class="table-wrap"><table><thead><tr><th>Batch</th><th>Project / School</th><th>Dates</th><th>Status</th></tr></thead><tbody>@foreach(var b in Model.Rows.Take(7)){<tr><td><a class="table-link" href="/Batches/Detail/@b.Id()">@b.Text("code")</a><small>@b.Text("name")</small></td><td>@b.Text("project")<small>@b.Text("school")</small></td><td>@b.Text("start_date")<small>to @b.Text("end_date")</small></td><td><span class="badge @(b.Text("status")=="Completed"?"green":b.Text("display_status")=="In progress"?"blue":"orange")">@b.Text("display_status")</span></td></tr>}@if(total==0){<tr><td colspan="4" class="empty">No batches match these filters.</td></tr>}</tbody></table></div></section></div>
<section class="insight"><span class="insight-icon">↗</span><div><strong>One plan. Many learning journeys.</strong><p>Reusable training plans keep delivery consistent while each batch has its own attendance and feedback.</p></div>@if(!User.IsInRole("Trainee")){<a href="/Plans" class="button secondary">Explore training plans →</a>}</section>
