@model Screen
@{ViewData["Title"]=Model.Title; var r=Model.Item; var projectIds=r.Text("projects")==""?new JsonArray():r.Array("projects"); var questions=Model.Kind=="template"&&r.Text("questions")!=""?r.Array("questions"):new JsonArray();}
<div class="page-heading"><div><span class="eyebrow">WORKSPACE SETUP</span><h1>@Model.Title</h1><p>Fields marked * are required.</p></div><a class="button secondary" href="/Masters?kind=@Model.Kind">← Back to directory</a></div>
@if(Model.Error!=""){<div class="notice error" role="alert">@Model.Error</div>}
<form method="post" class="panel form-panel">@Html.AntiForgeryToken()<input type="hidden" name="kind" value="@Model.Kind"/><input type="hidden" name="id" value="@r.Id()"/><div class="form-grid">
<label>Name *<input name="name" value="@r.Text("name")" required maxlength="200"/></label>
@if(Model.Kind is "project" or "school"){<label>Code *<input name="code" value="@r.Text("code")" required maxlength="60"/></label>}
@if(Model.Kind=="project"){<label class="span-2">Description<textarea name="description" rows="3" maxlength="2000">@r.Text("description")</textarea></label>}
@if(Model.Kind=="location"){<label>Location level *<select name="location_kind" required>@foreach(var k in new[]{"State","District","Block","Cluster"}){<option selected="@(r.Text("kind")==k)">@k</option>}</select></label><label>Parent location<select name="parent_id"><option value="">None (state only)</option>@foreach(var l in Model.Options("locations")){<option value="@l.Id()" selected="@(r.Id("parent_id")==l.Id())">@l.Text("kind") · @l.Text("name")</option>}</select></label>}
@if(Model.Kind=="school"){<label>Cluster / location *<select name="cluster_id" required><option value="">Select cluster</option>@foreach(var l in Model.Options("locations").Where(l=>l.Text("kind")=="Cluster")){<option value="@l.Id()" selected="@(r.Id("cluster_id")==l.Id())">@l.Text("parent") / @l.Text("name")</option>}</select></label>}
@if(Model.Kind is "trainee" or "user"){<label>Username *<input name="username" value="@r.Text("username")" required maxlength="100" autocomplete="off"/></label>}
@if(Model.Kind=="trainee"){<label>Mobile number *<input name="mobile" value="@r.Text("mobile")" required pattern="\+?[0-9]{10,15}" maxlength="16" inputmode="tel" placeholder="10–15 digits, optional +"/></label><label>Email address *<input name="email" type="email" value="@r.Text("email")" required maxlength="254"/></label><label>Project *<select name="project_id" id="project-select" required><option value="">Select project</option>@foreach(var p in Model.Options("projects").Where(p=>p.Flag())){<option value="@p.Id()" selected="@(r.Id("project_id")==p.Id())">@p.Text("name")</option>}</select></label><label>School *<select name="school_id" id="school-select" required><option value="">Select school</option>@foreach(var s in Model.Options("schools").Where(s=>s.Flag())){<option value="@s.Id()" data-projects="@s.Text("projects")" data-location="@s.Text("state") / @s.Text("district") / @s.Text("block") / @s.Text("cluster")" selected="@(r.Id("school_id")==s.Id())">@s.Text("name")</option>}</select></label><label class="span-2">State / District / Block / Cluster<input id="school-location" readonly value="@r.Text("state") / @r.Text("district") / @r.Text("block") / @r.Text("cluster")"/><small>Location follows the selected school.</small></label><label>Trainee login<select name="user_id"><option value="">No login linked</option>@foreach(var u in Model.Options("traineeusers")){<option value="@u.Id()" selected="@(r.Id("user_id")==u.Id())">@u.Text("name")</option>}</select><small>Create a user with the Trainee role to enable personal feedback submission.</small></label>}
@if(Model.Kind=="user"){<label>Role *<select name="role" required>@foreach(var role in new[]{"Administrator","Coordinator","Trainer","Trainee"}){<option selected="@(r.Text("role")==role)">@role</option>}</select></label><label>@(r.Id()==0?"Password *":"New password (optional)")<input name="password" type="password" minlength="10" required="@(r.Id()==0)" autocomplete="new-password" maxlength="200"/><small>At least 10 characters. Leave empty to keep the current password.</small></label>}
@if(Model.Kind is "school" or "user"){<fieldset class="span-2"><legend>@(Model.Kind=="school"?"Linked projects *":"Coordinator project permissions")</legend><div class="check-grid">@foreach(var p in Model.Options("projects")){<label class="checkbox"><input type="checkbox" name="projects" value="@p.Id()" checked="@(projectIds.Any(x=>x!.ToString()==p.Id().ToString()))"/>@p.Text("name")</label>}</div></fieldset>}
@if(Model.Kind is "project" or "school" or "trainee" or "user"){<label class="checkbox span-2"><input type="checkbox" name="active" value="true" checked="@r.Flag()"/>Active record</label>}
</div>
@if(Model.Kind=="template"){<div class="section-title"><h2>Feedback questions</h2><button type="button" class="button secondary" id="add-question">+ Add question</button></div><p class="muted">A saved revision creates a new version. Existing plans and submissions retain their original form.</p><div id="questions">@for(var i=0;i<Math.Max(1,questions.Count);i++){var q=i<questions.Count?questions[i]:null;<div class="question-row"><label>Question *<input name="question_label" value="@q?["label"]" required maxlength="500"/></label><label>Response type<select name="question_type">@foreach(var type in new[]{"Rating","Choice","Text"}){<option selected="@(q?["type"]?.ToString()==type)">@type</option>}</select></label><label>Choice options (separate with |)<input name="question_choices" value="@(q?["choices"] is JsonArray options?string.Join(" | ",options.Select(x=>x!.ToString())):"")" placeholder="Yes | No | Unsure"/></label><label class="checkbox"><input name="question_required" type="checkbox" value="@i" checked="@(q is null||q["required"]?.ToString()=="true")"/>Required</label></div>}</div>}
<div class="form-actions"><button class="button" type="submit">@(Model.Kind=="template"&&r.Id()>0?"Save new version":"Save record")</button><a href="/Masters?kind=@Model.Kind" class="button secondary">Cancel</a></div></form>
