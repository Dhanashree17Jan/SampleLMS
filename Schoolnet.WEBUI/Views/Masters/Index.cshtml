@model Screen
@{ViewData["Title"]=Model.Title; var edit=User.IsInRole("Administrator")||Model.Kind=="trainee";}
<div class="page-heading"><div><span class="eyebrow">DIRECTORY</span><h1>@Model.Title</h1><p>Keep your training workspace connected and up to date.</p></div>@if(edit){<a class="button" href="/Masters/Edit?kind=@Model.Kind">+ Add @(Model.Kind=="template"?"template":Model.Kind)</a>}</div>
<form method="get" class="panel filterbar"><input type="hidden" name="kind" value="@Model.Kind"/><label>Search<input name="search" value="@Model.Filters["search"]" placeholder="Search by name, code or username"/></label>
@if(Model.Kind=="trainee"){<label>Project<select name="project"><option value="0">All projects</option>@foreach(var p in Model.Options("projects")){<option value="@p.Id()" selected="@(p.Id().ToString()==Model.Filters["project"])">@p.Text("name")</option>}</select></label><label>School<select name="school"><option value="0">All schools</option>@foreach(var s in Model.Options("schools")){<option value="@s.Id()" selected="@(s.Id().ToString()==Model.Filters["school"])">@s.Text("name")</option>}</select></label>}
@if(Model.Kind is "project" or "school" or "trainee" or "user"){<label>Status<select name="status"><option value="">All statuses</option><option selected="@(Model.Filters["status"]=="Active")">Active</option><option selected="@(Model.Filters["status"]=="Inactive")">Inactive</option></select></label>}
<button class="button" type="submit">Search</button><a href="/Masters?kind=@Model.Kind">Reset</a></form>
@if(Model.Kind=="trainee"){<form method="get" class="panel filterbar"><input name="kind" type="hidden" value="trainee"/>@foreach(var keep in new[]{"search","project","school","status"}){<input name="@keep" type="hidden" value="@Model.Filters[keep]"/>}@foreach(var level in new[]{"State","District","Block","Cluster"}){var key=level.ToLowerInvariant();<label>@level<select name="@key"><option value="0">All @key locations</option>@foreach(var l in Model.Options("locations").Where(l=>l.Text("kind")==level)){<option value="@l.Id()" selected="@(Model.Filters[key]==l.Id().ToString())">@l.Text("name")</option>}</select></label>}<button class="button">Filter locations</button></form>}
<section class="panel"><div class="panel-heading"><h2>@Model.Title directory</h2><span class="muted">@Model.Rows.Count records</span></div><div class="table-wrap"><table><thead><tr><th>Name</th><th>@(Model.Kind=="trainee"||Model.Kind=="user"?"Username":Model.Kind=="location"?"Level":"Code / Version")</th><th>Details</th>@if(Model.Kind is not ("location" or "template")){<th>Status</th>}@if(edit){<th>Action</th>}</tr></thead><tbody>
@foreach(var r in Model.Rows){<tr><td><strong>@r.Text("name")</strong></td><td>@(Model.Kind is "trainee" or "user"?r.Text("username"):Model.Kind=="location"?r.Text("kind"):Model.Kind=="template"?"Version "+r.Text("version_number"):r.Text("code"))</td><td>@if(Model.Kind=="trainee"){<span>@r.Text("project") · @r.Text("school")</span><small>@r.Text("mobile") · @r.Text("email")</small>}else if(Model.Kind=="school"){<span>@r.Text("state") / @r.Text("district")</span><small>@r.Text("block") / @r.Text("cluster")</small>}else if(Model.Kind=="user"){<span>@r.Text("role")</span>}else if(Model.Kind=="template"){<span>@r.Array("questions").Count questions · Version remains stable for recorded responses</span>}else{<span>@r.Text(Model.Kind=="location"?"parent":"description")</span>}</td>@if(Model.Kind is not ("location" or "template")){<td><span class="badge @(r.Flag()?"green":"gray")">@(r.Flag()?"Active":"Inactive")</span></td>}@if(edit){<td>@if(Model.Kind!="location"){@if(Model.Kind=="trainee"){<a href="/Masters/ModifyTrainee/@r.Id()">Modify</a><span> · </span>}<a href="/Masters/Edit?kind=@Model.Kind&id=@r.Id()">@(Model.Kind=="template"?"View / revise":"Edit")</a>}</td>}</tr>}
@if(Model.Rows.Count==0){<tr><td colspan="5" class="empty">No records found. Add a record or adjust your search.</td></tr>}
</tbody></table></div></section>
