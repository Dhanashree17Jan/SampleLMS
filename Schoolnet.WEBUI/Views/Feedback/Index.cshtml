@model Screen
@{ViewData["Title"]=Model.Title;var f=Model.Item;var questions=f.Array("questions");var answers=JsonNode.Parse(f.Text("answers")==""?"{}":f.Text("answers"))!.AsObject();var staff=User.IsInRole("Administrator")||User.IsInRole("Coordinator");var locked=answers.Count>0&&!staff;}
<div class="page-heading"><div><span class="eyebrow">DAY @Model.Day · @f.Text("day_date")</span><h1>@Model.Title</h1><p>@f.Text("trainee") · @f.Text("template")</p></div><a href="/Batches/Detail/@f.Id("batch_id")" class="button secondary">← Batch details</a></div>@if(Model.Error!=""){<div class="notice error" role="alert">@Model.Error</div>}
@if(locked){<div class="notice success">Your final submission is saved and locked.</div>}
<form method="post" action="/Feedback/Save" class="panel form-panel feedback-form">@Html.AntiForgeryToken()<input name="assignment" type="hidden" value="@f.Id()"/><input name="day" type="hidden" value="@Model.Day"/>
@foreach(var question in questions){var q=question!;var key=q["id"]!.ToString();var required=q["required"]?.ToString()=="true";var value=answers[key]?.ToString()??"";<label>@q["label"] @(required?"*":"")
@if(q["type"]!.ToString()=="Rating"){<select name="@key" required="@required" disabled="@locked"><option value="">Select rating</option>@for(var i=1;i<=5;i++){<option value="@i" selected="@(value==i.ToString())">@i @(i==1?"· Very low":i==5?"· Excellent":"")</option>}</select>}else if(q["type"]!.ToString()=="Choice"){<select name="@key" required="@required" disabled="@locked"><option value="">Select answer</option>@foreach(var option in q["choices"]!.AsArray()){<option selected="@(value==option!.ToString())">@option</option>}</select>}else{<textarea name="@key" rows="3" required="@required" readonly="@locked" maxlength="5000">@value</textarea>}</label>}
@if(staff){<label>Reason for offline, late entry or correction<input name="reason" value="@f.Text("reason")" maxlength="2000"/><small>Attribution and the reason are retained in audit history.</small></label>}
@if(!locked){<div class="notice info">Feedback is available on the date of this activity. Staff may enter late or offline responses with a reason. Attendance is recorded separately.</div><button class="button">Submit feedback</button>}</form>
